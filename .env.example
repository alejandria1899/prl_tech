POSTGRES_DB=prl_tech
POSTGRES_USER=prl_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432
ADMINER_PORT=8080
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api

# Local FastAPI database URL when running the API outside Docker:
DATABASE_URL=postgresql+psycopg://prl_user:change_me_in_production@localhost:5432/prl_tech

# ThingSpeak import. Keep real values only in .env, never in git.
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_DEFAULT_RESULTS=1000
THINGSPEAK_SYNC_ENABLED=true
THINGSPEAK_SYNC_DEVICE_CODE=home_dht22
THINGSPEAK_SYNC_INTERVAL_SECONDS=60
